{
  "name": "kavoma-time",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "productName": "Kavoma Time",
  "description": "Professionelle Zeiterfassung und Projektverwaltung für Freelancer und Teams.",
  "author": "Artjom Kaufmann",
  "license": "Apache-2.0",
  "homepage": "https://github.com/Kavoma/Kavoma-Time",
  "repository": {
    "type": "git",
    "url": "https://github.com/Kavoma/Kavoma-Time.git"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "electron": "electron .",
    "electron:dev": "concurrently --kill-others --names \"VITE,ELECTRON\" --prefix-colors \"cyan,magenta\" \"pnpm dev\" \"wait-on http://localhost:5173 && pnpm electron\"",
    "dist": "pnpm build && electron-builder",
    "dist:mac": "pnpm build && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac",
    "dist:mac:signed": "pnpm build && electron-builder --mac",
    "dist:win": "pnpm build && electron-builder --win --x64",
    "dist:portable": "pnpm build && electron-builder --win portable --x64",
    "dist:publish": "pnpm build && electron-builder --win nsis --x64 --publish always",
    "dist:publish:mac": "pnpm build && electron-builder --mac --publish always",
    "version-set": "npm version --no-git-tag-version",
    "lint": "eslint . --report-unused-disable-directives"
  },
  "build": {
    "appId": "com.kavoma.time",
    "productName": "Kavoma Time",
    "publish": [
      {
        "provider": "github",
        "owner": "Kavoma",
        "repo": "Kavoma-Time",
        "releaseType": "release"
      }
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "icon": "build/icons/win/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Kavoma Time",
      "license": "LICENSE",
      "artifactName": "Kavoma-Time-Setup-${version}-${arch}.${ext}"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json",
      "LICENSE",
      "NOTICE"
    ],
    "asar": true,
    "artifactName": "Kavoma-Time-${version}-${os}-${arch}.${ext}",
    "mac": {
      "icon": "build/icons/mac/icon.icns",
      "category": "public.app-category.productivity",
      "minimumSystemVersion": "11.0",
      "darkModeSupport": true,
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "notarize": false,
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "extendInfo": {
        "NSHumanReadableCopyright": "Copyright (C) 2026 Artjom Kaufmann",
        "LSMultipleInstancesProhibited": true
      }
    },
    "dmg": {
      "title": "Kavoma Time ${version}",
      "icon": "build/icons/mac/icon.icns",
      "contents": [
        {
          "x": 140,
          "y": 200,
          "type": "file"
        },
        {
          "x": 400,
          "y": 200,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "portable": {
      "artifactName": "Kavoma-Time-Portable-${version}-${arch}.${ext}"
    },
    "afterPack": "build/afterPack.cjs"
  },
  "dependencies": {
    "electron-store": "^11.0.2",
    "electron-updater": "^6.8.3",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.7",
    "pdf-lib": "^1.17.1",
    "react-colorful": "^5.7.0",
    "recharts": "^3.8.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@fontsource-variable/bricolage-grotesque": "^5.2.10",
    "@fontsource/inter": "^5.2.8",
    "@tailwindcss/vite": "^4.3.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "^9.2.1",
    "electron": "^42.0.1",
    "electron-builder": "^26.15.3",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "framer-motion": "^12.38.0",
    "globals": "^17.6.0",
    "lucide-react": "^1.16.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "tailwindcss": "^4.3.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.3",
    "vite": "^8.0.13",
    "wait-on": "^9.0.10"
  }
}
