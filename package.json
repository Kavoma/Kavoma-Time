{
  "name": "kavoma-time",
  "version": "1.0.1",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "productName": "Kavoma Time",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "electron": "electron .",
    "electron:dev": "concurrently --kill-others --names \"VITE,ELECTRON\" --prefix-colors \"cyan,magenta\" \"pnpm dev\" \"wait-on http://localhost:5173 && pnpm electron\"",
    "dist:portable": "pnpm build && electron-builder --win portable",
    "lint": "eslint . --report-unused-disable-directives"
  },
  "build": {
    "appId": "com.kavoma.time",
    "productName": "Kavoma Time",
    "directories": {
      "output": "release"
    },
    "win": {
      "icon": "build/icon.png"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "asar": true
  },
  "dependencies": {
    "electron-store": "^11.0.2",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.7",
    "recharts": "^3.8.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@fontsource-variable/bricolage-grotesque": "^5.2.10",
    "@fontsource/inter": "^5.2.8",
    "@tailwindcss/vite": "^4.3.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "^9.2.1",
    "electron": "^42.0.1",
    "electron-builder": "^26.8.1",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "framer-motion": "^12.38.0",
    "globals": "^17.6.0",
    "lucide-react": "^1.14.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "tailwindcss": "^4.3.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.10",
    "wait-on": "^9.0.6"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "electron-builder",
      "electron-winstaller"
    ]
  }
}